# Copy to backend/.env.docker and edit. Generate APP_KEY with:  docker compose run --rm api php artisan key:generate --show
APP_NAME="Chefs Trolley API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=chefs_trolley
DB_USERNAME=chefs
DB_PASSWORD=chefs_dev_password

CACHE_STORE=redis
QUEUE_CONNECTION=database
SESSION_DRIVER=array
REDIS_HOST=redis

# Optional: lets monitors read queue/scheduler details from GET /api/v1/health (header X-Health-Token)
HEALTH_TOKEN=

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3001
WEBSITE_URL=http://localhost:3001
