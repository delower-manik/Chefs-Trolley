APP_NAME="Chefs Trolley API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Storage timezone for timestamps. Keep UTC: branches carry their own timezone
# (branches.timezone) and reports convert calendar days per branch.
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# MySQL (default). For a zero-setup local run use SQLite instead:
#   DB_CONNECTION=sqlite  (and run: touch database/database.sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chefs_trolley
DB_USERNAME=root
DB_PASSWORD=

# --- Runtime services -------------------------------------------------------
# Defaults need no extra infrastructure. Redis-backed cache/queues arrive with
# the real-time/queue phase; until then keep these.
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=array
FILESYSTEM_DISK=local
MAIL_MAILER=log
BCRYPT_ROUNDS=12

# --- Browser access ---------------------------------------------------------
# The API is bearer-token only (no cookies, no CSRF). CORS must still allow the
# web app's origin; comma-separate several origins.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Public customer website origin: payment gateways send the customer back here after paying.
WEBSITE_URL=http://localhost:3001

# --- Phase 14: real-time, notifications, webhooks ---
# Real-time driver: null | log | pusher | reverb | ably
REALTIME_DRIVER=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
# Leave host empty for hosted Pusher. For Reverb set host/port/scheme.
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=https
ABLY_KEY=

# SMS driver: none | twilio | bulksmsbd | sslwireless | greenweb | alphasms | elitbuzz
SMS_DRIVER=none
NOTIFY_ORDER_SMS=false
NOTIFY_ORDER_PUSH=false
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
GREENWEB_TOKEN=
ALPHASMS_API_KEY=
ELITBUZZ_API_KEY=
ELITBUZZ_SENDER_ID=

# Firebase push: service-account JSON (raw, base64 or a file path)
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# Email uses Laravel mail: set MAIL_MAILER=smtp and your own domain's SMTP credentials.
WEBHOOKS_ALLOW_INSECURE=false
CAMPAIGN_MAX_RECIPIENTS=5000

# Optional: lets monitors read queue/scheduler details from GET /api/v1/health (send header X-Health-Token)
HEALTH_TOKEN=

# Behind nginx/LB/Cloudflare: comma list of proxy IPs/CIDRs (or * if only reachable via the proxy)
TRUSTED_PROXIES=
