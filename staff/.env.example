# Public URL of the Laravel API, including /api/v1 (browser calls it directly; add this app's origin to CORS_ALLOWED_ORIGINS).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Push notifications (optional). Firebase console -> Project settings -> your Web app, and Cloud Messaging -> Web Push certificate (VAPID key).
# Leave empty to run without push: staff then see updates when they open or refresh the app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
