# Public URL of the Laravel API, including /api/v1. Used by the browser AND by the server when rendering pages.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Public address of THIS website (sitemap, canonical links, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Language for bare URLs like /menu (en or bn). Baked in at build time.
NEXT_PUBLIC_DEFAULT_LOCALE=en
